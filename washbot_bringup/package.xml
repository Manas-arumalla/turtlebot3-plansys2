<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>washbot_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch files, navigation configuration, maps and RViz profiles for
    WashBot missions: pure simulation (no robot required), TurtleBot3 +
    Nav2 bringup, and PlanSys2 integration.
  </description>
  <maintainer email="manasreddyarumalla@gmail.com">Manas Reddy Arumalla</maintainer>
  <license>Apache-2.0</license>


  <exec_depend>washbot_planning</exec_depend>
  <exec_depend>washbot_control</exec_depend>

  <!-- Only needed for the TurtleBot3/Nav2 launch profiles. -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
